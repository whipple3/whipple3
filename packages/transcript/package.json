{
  "name": "@whipple3/transcript",
  "version": "0.1.0",
  "description": "Read a Claude Code session transcript and project it into a whipple3 log — the shape the Studio already renders.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "subagents",
    "transcript",
    "observability"
  ],
  "license": "MIT",
  "homepage": "https://github.com/whipple3/whipple3#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whipple3/whipple3.git",
    "directory": "packages/transcript"
  },
  "bugs": "https://github.com/whipple3/whipple3/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@whipple3/core": "workspace:*",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
