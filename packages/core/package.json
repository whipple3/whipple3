{
  "name": "@whipple3/core",
  "version": "0.1.0",
  "description": "whipple3's pure core: immutable graph state, the apply() reducer with optimistic versioning and claim/lease semantics, ACL checks, typed slices — no I/O, one dependency (Zod).",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "blackboard",
    "coordination",
    "event-sourcing",
    "graph"
  ],
  "license": "MIT",
  "homepage": "https://github.com/whipple3/whipple3#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whipple3/whipple3.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/whipple3/whipple3/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
