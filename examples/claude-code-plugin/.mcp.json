{
  "mcpServers": {
    "whipple3-scanner": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "whipple3",
        "mcp",
        "--board",
        "${CLAUDE_PROJECT_DIR}/.whipple3/board.sock",
        "--agent",
        "scanner"
      ]
    },
