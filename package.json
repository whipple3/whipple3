{
  "name": "whipple3-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --filter './packages/*' --filter './tools/*' exec tsc -p tsconfig.json --noEmit",
    "build": "pnpm -r --filter './packages/*' --filter './tools/*' run --if-present build",
    "test": "vitest run && pnpm -C tools/bench test",
    "lint": "biome check .",
    "depcruise": "depcruise packages tools --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "dependency-cruiser": "^16.0.0",
    "fast-check": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
